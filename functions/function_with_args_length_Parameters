# implement function with argument length parameter
def argsLengthFunction(*args):
    
    if any(arg < 0 for arg in args):
        return "Negative number argument not allowed"
    
    if not args:
        return 2
    
    if len(args) == 1:
        return args[0]
    
    else:
        return sum(args)

res = argsLengthFunction(12)

print(res)
