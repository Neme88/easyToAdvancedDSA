 # O(n) algorithm implementations
 # summing numbers in a list
def sum_values(arr):
    total = 0
    for i in arr:
        total+= i
    return total
total_value =  sum_values([2,5,6,8])
print(total_value)

# count the occurance of an element in a list
def count_occurances(arr, target_value):
    counter = 0
    for num in arr:
        if num == target_value:
            counter += 1
    return counter

arr = [2, 4, 2, 1, 2, 6, 4, 8, 3]
target_value = 2
print(count_occurances(arr, target_value))

# search a for a given number in an unsorted list of numbers
def search_for_number( arr, target_number):
    for i in arr:
        if i == target_number:
            return f"The targeted number which is {i} is in position {arr[i]}."
    return -1
arr = [2, 4, 2, 1, 2]
target_number = 4
print(search_for_number(arr, target_number))

# coppy all the elements in one list to another emppty list.

def copy_list(arr):
    new_list = []
    for elements in arr:
        new_list.append(elements)
    
    return new_list

new_list = copy_list([1, 2, 4, 8, 16, 32, 64, 128])
print(new_list)

